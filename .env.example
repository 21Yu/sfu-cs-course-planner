APP_NAME="SFU CS Course Planner API"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=false
SFU_COURSES_API_BASE_URL="https://api.sfucourses.com/v1/rest"
SFU_COURSES_API_TIMEOUT_SECONDS=10
DATABASE_URL="postgresql+psycopg://planner:planner@localhost:5432/course_planner"
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME="session"
# Leave unset to use Secure cookies everywhere except APP_ENV=development
# SESSION_COOKIE_SECURE=true
